# ─────────────────────────────────────────────────────────────────────────────
# SentinelAI — environment variable reference
# Copy to .env and fill in values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM provider ──────────────────────────────────────────────────────────────
# Options: groq | ollama | fake
# - groq  : Groq Cloud API (default for real runs)
# - ollama: fully offline via local Ollama daemon
# - fake  : deterministic scripted client used in all CI / offline tests
LLM_PROVIDER=fake

# ── Groq (used when LLM_PROVIDER=groq) ───────────────────────────────────────
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Main reasoning model — used for agent analysis and the Evidence Validator judge.
# Current Groq options (check https://console.groq.com/docs/models for latest):
#   llama-3.3-70b-versatile       (70B, best quality, ~12k TPM free tier)
#   llama-3.1-8b-instant          (8B, fastest, ~14.4k TPM free tier)
#   mixtral-8x7b-32768            (MoE, large context)
#   gemma2-9b-it                  (Google Gemma 2 9B)
GROQ_MODEL=llama-3.3-70b-versatile

# Fast / cheap model — used for the Orchestrator's optional steps.
# Recommended: a smaller, faster model to save tokens & stay within rate limits.
GROQ_FAST_MODEL=llama-3.1-8b-instant

# ── Groq rate-limit tuning ────────────────────────────────────────────────────
# Set these to match your Groq account tier to avoid 429s.
# Free-tier conservative defaults:
#   RPM  = 30  (requests per minute across all models)
#   TPM  = 6000 (tokens per minute — set to your lowest model limit)
# Paid tier: raise these to match your plan.
GROQ_RPM_LIMIT=30
GROQ_TPM_LIMIT=6000

# Max parallel LLM calls (Auth / Timeline / Correlation fan-out).
# Keep at 1-2 on the free tier to avoid 429s.
MAX_CONCURRENT_LLM_CALLS=2

# ── Ollama (used when LLM_PROVIDER=ollama) ────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ── Data stores ───────────────────────────────────────────────────────────────
# DuckDB file for the log store (default: in-memory for tests)
LOG_STORE_PATH=data/logs.duckdb

# DuckDB file for the RAG store (IOCs, CVEs, links)
RAG_DB_PATH=data/rag.duckdb

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=data/chroma

# ── MITRE ATT&CK ──────────────────────────────────────────────────────────────
# Local path to the cached STIX JSON (downloaded on first --refresh run)
MITRE_STIX_PATH=data/mitre/enterprise-attack.json

# ── Investigation limits ───────────────────────────────────────────────────────
MAX_VALIDATION_LOOPS=2
MAX_TOOL_CALLS_PER_AGENT=8
MAX_TOKENS_PER_INCIDENT=80000

# ── Confidence caps ────────────────────────────────────────────────────────────
# A finding with only one cited event cannot exceed this confidence
SINGLE_EVENT_CONFIDENCE_CAP=0.6
# An intel-only finding (no corroborating log evidence) cannot exceed this
INTEL_ONLY_CONFIDENCE_CAP=0.65

# ── Tracing ───────────────────────────────────────────────────────────────────
# Options: none | langfuse | langsmith (default: none; local JSON trace always on)
TRACE_BACKEND=none
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false

# ── Live enrichment feature flags (all off by default) ────────────────────────
ENABLE_ABUSEIPDB=false
ABUSEIPDB_API_KEY=

ENABLE_OTX=false
OTX_API_KEY=

ENABLE_NVD_LIVE=false
NVD_API_KEY=

# ── Report ────────────────────────────────────────────────────────────────────
ENABLE_PDF=false
REPORT_OUTPUT_DIR=reports/

# ── RAG / embeddings ──────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_FALLBACK_MODEL=sentence-transformers/all-MiniLM-L6-v2
SENTENCE_TRANSFORMERS_HOME=data/models

# CVE ingestion scope
CVE_YEARS_BACK=3
CVE_MIN_CVSS=7.0
